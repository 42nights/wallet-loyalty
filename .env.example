# ---- App ----
# Public URL of THIS app. MUST be https in production — Wallet won't talk to http.
PUBLIC_BASE_URL=https://loyalty.42nights.dev
SESSION_SECRET=generate-a-long-random-string

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, never expose to client

# ---- Apple pass identifiers ----
PASS_TYPE_ID=pass.com.42nights.loyalty  # your registered Pass Type ID
APPLE_TEAM_ID=ABCDE12345                 # 10-char Team ID
PASS_ORG_NAME=42nights

# ---- Apple certs (base64-encoded PEM — see README for how to make these) ----
APPLE_WWDR_PEM=                          # base64 of AppleWWDRCAG4.pem
PASS_SIGNER_CERT_PEM=                    # base64 of your pass cert (PEM)
PASS_SIGNER_KEY_PEM=                     # base64 of the matching private key (PEM)
PASS_SIGNER_KEY_PASSPHRASE=              # leave blank if key isn't encrypted

# ---- APNs ----
# prod: https://api.push.apple.com   sandbox: https://api.sandbox.push.apple.com
APNS_HOST=https://api.push.apple.com

# ---- Anthropic (CRM AI layer — Phase 4) ----
# Powers /api/merchant/ask (Sonnet/Opus) and /api/merchant/digest (Haiku).
# Without it those routes return 503; the rest of the app is unaffected.
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
AI_DAILY_TOKEN_CAP=200000               # soft per-merchant daily token cap

# ---- Sales CRM (/admin/sales) — all optional except the postal address for email ----
# Postal address for the CAN-SPAM footer on every sales email. Unset = email
# scripts and the email AI drafts are disabled ("Set SALES_POSTAL_ADDRESS").
SALES_POSTAL_ADDRESS=                    # e.g. PO Box 123, Austin, TX 78701
# "Shop, Street" of a pilot that agreed to be named in scripts. Unset = the
# line naming a shop is left out.
SALES_REFERENCE_SHOP=                    # e.g. Bean & Bun, Elm St
SALES_AI_DAILY_TOKEN_CAP=100000          # daily token cap for Sales AI drafts (needs ANTHROPIC_API_KEY)
